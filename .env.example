# Copy to .env for local development. Never commit .env.
# Matches the `postgres` service in compose.yaml (development-only credentials).
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# GitHub OAuth app (Settings > Developer settings > OAuth Apps).
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# 1 = open, as in development: public sign-up with email and GitHub login (needs the two above).
# Leave it out in production: the doors are closed and accounts are made with `npm run user:create`.
OPEN_ACCESS=1

# Public base URL (defaults to http://localhost:3000).
# APP_URL="http://localhost:3000"

# Email for account confirmation (Resend, https://resend.com). Optional in development: without a
# key the confirmation link is printed in the server console. Required in production.
# The public demo: "Explore the demo" on the landing page signs in a read-only visitor to a sample
# workspace that the daily job renews. Leave unset to keep it off.
# DEMO_ENABLED=1

# Secret for the daily alerts job (Vercel Cron sends it as a Bearer token; the endpoint is off without it).
# Generate like BETTER_AUTH_SECRET. Run it locally with: npm run alerts:run
# CRON_SECRET=

# RESEND_API_KEY=""
# EMAIL_FROM="TaskFlow <login@your-verified-domain>"
