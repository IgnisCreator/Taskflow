# Copy to .env for local development. Never commit .env.
# Matches the `postgres` service in compose.yaml (development-only credentials).
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# GitHub OAuth app (Settings > Developer settings > OAuth Apps).
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Public base URL (defaults to http://localhost:3000).
# APP_URL="http://localhost:3000"
