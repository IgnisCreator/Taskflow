// Authentication tables come from `auth generate` (Better Auth 1.7.7) plus the project additions
// marked below. Domain models (TF-03) follow the auth tables.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id
  /**
   * Random, shareable identifier used to add collaborators (the email is never a permission).
   */
  publicId      String            @unique @default(uuid())
  name          String
  email         String
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   WorkspaceMember[]
  createdTasks  Task[]
  assignments   TaskAssignee[]
  comments      Comment[]
  /// Wants the daily email with the open alerts (the in-app inbox is always on).
  digestEmail   Boolean           @default(false)
  /// The visitor of the public demo and its made-up teammates: read-only, never a real person.
  isDemo        Boolean           @default(false)
  notifications Notification[]
  emailLogs     EmailLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// OWNER is held by exactly one member per workspace (the creator); it is never granted through the API.
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

/// What a stage means for the metrics. The order is BACKLOG, ACTIVE or WAITING, DONE, DISCARDED.
enum StageCategory {
  BACKLOG
  ACTIVE
  WAITING
  DONE
  DISCARDED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

/// The organisation. Everything below it (spaces, folders, lists, tasks) belongs to exactly one.
model Workspace {
  id         String             @id @default(uuid())
  name       String
  /// Display names chosen by the workspace for each role, e.g. {"GUEST": "Client"}; permissions never change.
  roleLabels Json               @default("{}")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  members    WorkspaceMember[]
  spaces     Space[]
  templates  WorkflowTemplate[]
  types      WorkItemType[]
  labels     Label[]
  /// The sample workspace of the public demo: the only one the daily regeneration may delete.
  isDemo     Boolean            @default(false)
}

/// What kind of work a task is (Task, Bug, Request...). Chosen by the workspace; metrics can be split by it.
model WorkItemType {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([workspaceId, name])
}

/// A free tag of the workspace, attached to any number of tasks.
model Label {
  id          String      @id @default(uuid())
  workspaceId String
  name        String
  createdAt   DateTime    @default(now())
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       TaskLabel[]

  @@unique([workspaceId, name])
}

/// A flow saved by the organisation from one of its lists. The system templates live in the code.
model WorkflowTemplate {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  /// Ordered stages: [{ name, category, wipLimit, policy, isCommitmentPoint }], validated on write.
  stages      Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])
  spaces      SpaceMember[]

  @@id([workspaceId, userId])
  @@index([userId])
}

/// An area of work (e.g. Software, Support). Private spaces are visible to OWNER/ADMIN and to the
/// members listed in SpaceMember; public ones to every MEMBER too. GUESTs only see spaces they are listed in.
model Space {
  id              String        @id @default(uuid())
  workspaceId     String
  name            String
  isPrivate       Boolean       @default(false)
  /// Flow copied into new lists: "system:<key>" or a WorkflowTemplate id. Null means the folder's or "system:generic".
  defaultTemplate String?
  createdAt       DateTime      @default(now())
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members         SpaceMember[]
  folders         Folder[]
  lists           List[]

  @@index([workspaceId])
}

model SpaceMember {
  spaceId     String
  workspaceId String
  userId      String
  space       Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// Leaving the workspace removes every space membership with it.
  member      WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@id([spaceId, userId])
  @@index([workspaceId, userId])
}

/// Optional grouping of lists inside a space.
model Folder {
  id              String   @id @default(uuid())
  spaceId         String
  name            String
  /// Same as Space.defaultTemplate; wins over the space's.
  defaultTemplate String?
  createdAt       DateTime @default(now())
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  lists           List[]

  @@index([spaceId])
}

/// A board. Lives in a space, optionally inside one of that space's folders.
model List {
  id               String         @id @default(uuid())
  spaceId          String
  folderId         String?
  name             String
  description      String?
  /// Bumped once by every board mutation; used for optimistic concurrency (expectedBoardVersion).
  boardVersion     Int            @default(0)
  /// Thresholds of the daily alerts (see src/lib/alerts.ts).
  alertBandDays    Int            @default(3)
  alertWipDays     Int            @default(3)
  alertDropPercent Int            @default(50)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  space            Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  folder           Folder?        @relation(fields: [folderId], references: [id], onDelete: Cascade)
  columns          BoardColumn[]
  tasks            Task[]
  events           TaskEvent[]
  notifications    Notification[]

  @@index([spaceId])
  @@index([folderId])
}

/// A stage of a list's flow (shown as a column). Each list owns its stages, copied from a template.
model BoardColumn {
  id                String        @id @default(uuid())
  listId            String
  name              String
  position          Int
  category          StageCategory
  /// Where the cycle time starts. Exactly one per list, on an ACTIVE stage.
  isCommitmentPoint Boolean       @default(false)
  /// Advisory limit of tasks in the stage: it raises an alert, never blocks.
  wipLimit          Int?
  /// Short text: what it takes to enter or leave the stage.
  policy            String?
  list              List          @relation(fields: [listId], references: [id], onDelete: Cascade)
  tasks             Task[]
  eventsFrom        TaskEvent[]   @relation("eventFrom")
  eventsTo          TaskEvent[]   @relation("eventTo")

  @@unique([listId, id])
  @@unique([listId, position])
}

model Task {
  id            String         @id @default(uuid())
  listId        String
  columnId      String
  title         String
  description   String?
  priority      Priority       @default(MEDIUM)
  typeId        String?
  /// Why the task is blocked; null when it is not. Time spent blocked is measured from the events.
  blockedReason String?
  /// Calendar date (YYYY-MM-DD), no time zone.
  dueDate       DateTime?      @db.Date
  position      Int
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  list          List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  // Composite foreign key keeps a task and its column inside one list.
  // NoAction (verified in verificacion/06_experimento_fk.md): never SetNull, it would null listId.
  column        BoardColumn    @relation(fields: [listId, columnId], references: [listId, id], onDelete: NoAction)
  type          WorkItemType?  @relation(fields: [typeId], references: [id], onDelete: SetNull)
  createdBy     User           @relation(fields: [createdById], references: [id])
  /// Everyone who works on it; each must be able to see the list (checked by the service).
  assignees     TaskAssignee[]
  labels        TaskLabel[]
  subtasks      Subtask[]
  comments      Comment[]
  events        TaskEvent[]

  @@index([listId, columnId, position])
  @@index([typeId])
  @@index([listId, priority])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
  @@index([userId])
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

/// A checklist item. It is not a task: it never counts in throughput or cycle time.
model Subtask {
  id       String  @id @default(uuid())
  taskId   String
  title    String
  done     Boolean @default(false)
  position Int
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

enum TaskEventType {
  CREATED
  MOVED
  BLOCKED
  UNBLOCKED
  DISCARDED
  REOPENED
}

/// Append-only history of what happens to a task: the base of every flow metric. The category of
/// the stage is copied into the event, so later changes to a flow never rewrite the past.
/// Rows are only ever inserted (and removed with their task or list).
model TaskEvent {
  id           String         @id @default(uuid())
  taskId       String
  listId       String
  type         TaskEventType
  fromStageId  String?
  toStageId    String?
  fromCategory StageCategory?
  toCategory   StageCategory?
  actorId      String
  at           DateTime       @default(now())
  task         Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  list         List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  fromStage    BoardColumn?   @relation("eventFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage      BoardColumn?   @relation("eventTo", fields: [toStageId], references: [id], onDelete: SetNull)

  @@index([listId, at])
  @@index([taskId, at])
}

enum AlertKind {
  WIP_OVER_LIMIT
  BAND_WIDENING
  TASK_AGING
  THROUGHPUT_DROP
}

/// One alert for one person. `key` identifies the condition (stage, task or the list's throughput):
/// while the condition holds there is one open row; when it stops holding the row is resolved.
model Notification {
  id         String    @id @default(uuid())
  userId     String
  listId     String
  kind       AlertKind
  key        String
  message    String
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  list       List      @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([userId, resolvedAt, createdAt])
  @@index([listId, key])
}

enum EmailStatus {
  SENT
  FAILED
}

/// Evidence that an email was sent (or why it was not). Never holds the body.
model EmailLog {
  id        String      @id @default(uuid())
  userId    String
  subject   String
  status    EmailStatus
  error     String?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Better Auth's request counters (sign-in and the like), kept in PostgreSQL so that every
/// serverless instance sees the same numbers. The shape is the one Better Auth expects.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

/// Our own fixed-window counters (writes of the API per address, entries to the demo).
model ApiRateLimit {
  key       String
  /// The window number: floor(time / window length).
  window    Int
  count     Int
  /// When the row can be deleted.
  expiresAt DateTime

  @@id([key, window])
  @@index([expiresAt])
}
